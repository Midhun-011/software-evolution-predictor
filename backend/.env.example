# Copy this file to .env and set secure values
# Never commit your real secrets to version control

# JWT secret used to sign tokens
JWT_SECRET=change_this_to_a_strong_secret

# Token expiry (e.g., 1h, 7d)
JWT_EXPIRY=7d

# Backend port
PORT=4000

# MongoDB connection string (optional — app falls back to file-based storage)
MONGODB_URI=mongodb://localhost:27017/software-evolution-predictor
